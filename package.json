{
  "name": "card-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Static SolidJS app: upload a CSV, design a badge template, generate printable cards.",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite",
    "build": "panda codegen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "panda codegen && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:ui": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:report": "playwright show-report",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.3",
    "lucide-solid": "^1.55.0",
    "papaparse": "^5.7.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
